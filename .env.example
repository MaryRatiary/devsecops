# App image / Harbor
APP_VERSION=1.0.0
REGISTRY=localhost:8082
IMAGE_REPOSITORY=mlops/lyrx
APP_BUILD_CONTEXT=.
APP_DOCKERFILE=Dockerfile
APP_PORT=8000
APP_ENV=production
APP_RESTART_POLICY=unless-stopped
APP_HEALTHCHECK_INTERVAL=30s
APP_HEALTHCHECK_TIMEOUT=10s
APP_HEALTHCHECK_RETRIES=3
APP_HEALTHCHECK_START_PERIOD=40s

# Jenkins local
JENKINS_IMAGE=lyrx-jenkins:2.559-jdk17
JENKINS_BUILD_CONTEXT=.
JENKINS_DOCKERFILE=docker/jenkins/Dockerfile
JENKINS_USER=root
JENKINS_HTTP_PORT=8081
JENKINS_AGENT_PORT=50000
JENKINS_CONTAINER_HTTP_PORT=8080
JENKINS_CONTAINER_AGENT_PORT=50000
JENKINS_HOME_VOLUME=./.docker/jenkins_home
JENKINS_HOME_PATH=/var/jenkins_home
JENKINS_RESTART_POLICY=unless-stopped
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_SOCKET_TARGET=/var/run/docker.sock

# SonarQube local
SONARQUBE_IMAGE=sonarqube:10.7-community
SONARQUBE_PORT=9000
SONARQUBE_CONTAINER_PORT=9000
SONARQUBE_DATA_VOLUME=./.docker/sonarqube_data
SONARQUBE_DATA_PATH=/opt/sonarqube/data
SONARQUBE_EXTENSIONS_VOLUME=./.docker/sonarqube_extensions
SONARQUBE_EXTENSIONS_PATH=/opt/sonarqube/extensions
SONARQUBE_LOGS_VOLUME=./.docker/sonarqube_logs
SONARQUBE_LOGS_PATH=/opt/sonarqube/logs
SONARQUBE_RESTART_POLICY=unless-stopped
SONAR_DB_IMAGE=postgres:15-alpine
SONAR_DB_CONTAINER_PORT=5432
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_sonar
SONAR_DB_NAME=sonar
SONAR_DB_VOLUME=./.docker/sonar_postgres
SONAR_DB_DATA_PATH=/var/lib/postgresql/data
SONAR_DB_RESTART_POLICY=unless-stopped

# Jenkins pipeline defaults
TRIVY_IMAGE=aquasec/trivy:0.58.1
KUBESCAPE_IMAGE=quay.io/kubescape/kubescape:v3.0.17
REGISTRY_CREDENTIALS_ID=registry-credentials
SONARQUBE_ENV=SonarQube
K8S_NAMESPACE=lyrx
K8S_DEPLOYMENT=lyrx
K8S_CONTAINER=lyrx

# Kubernetes template variables
K8S_APP_NAME=lyrx
K8S_REPLICAS=2
K8S_SERVICE=lyrx
CONTAINER_PORT=8000
SERVICE_PORT=80
K8S_READINESS_INITIAL_DELAY=20
K8S_READINESS_PERIOD=10
K8S_LIVENESS_INITIAL_DELAY=40
K8S_LIVENESS_PERIOD=20
K8S_CPU_REQUEST=250m
K8S_MEMORY_REQUEST=512Mi
K8S_CPU_LIMIT=1
K8S_MEMORY_LIMIT=2Gi
K8S_RUN_AS_USER=1000
K8S_RUN_AS_GROUP=1000

# Deployment legacy / optional
DEPLOY_SERVER=prod-server.example.com
DEPLOY_USER=deploy
SSH_PRIVATE_KEY=
MODEL_PATH=/app/models/model.pkl
LOG_LEVEL=INFO
GRAFANA_PASSWORD=change_me_grafana
